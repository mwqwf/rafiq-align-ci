      "alignmentInput": [
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِ",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "فِيهِمَا فَٰكِهَة وَنَخْل وَرُمَّان",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "فِيهِنَّ خَيْرَٰتٌ حِسَان",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "حُور مَّقْصُورَٰت فِي اِلْخِيَامِ",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "لَمْ يَطْمِثْهُنَّ إِنس قَبْلَهُمْ وَلَا جَآنّ",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "مُتَّكِـِينَ عَلَىٰ رَفْرَفٍ خُضْر وَعَبْقَرِيٍّ حِسَان",
        "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
        "تَبَٰرَكَ اَسْمُ رَبِّكَ ذِي اِلْجَلَٰلِ وَالِاكْرَامِ"
      ],
