verdict": "clean", "heard": "الر تكي", "rung": 3000}, {"surah": 16, "startMs": 6860, "verdict": "unknown", "heard": "وما وما ويسجقون"}, {"surah": 17, "startMs": 6777, "verdict": "unknown", "heard": "وهها الذي اسري بابده بين مسد"}, {"surah": 18, "startMs": 10573, "verdict": "unknown", "heard": "وجا فيع اليمد وما سجديد من"}, {"surah": 20, "startMs": 4280, "verdict": "unknown", "heard": "قالوا ما ازليك الله لتشقي"}, {"surah": 21, "startMs": 4211, "verdict": "unknown", "heard": "وبينا سرسابهم ووفي غفه معرضون"}, {"surah": 22, "startMs": 2354, "verdict": "unknown", "heard": "من ياايع الناس تقول ربكون"}, {"surah": 24, "startMs": 4240, "verdict": "clean", "heard": "شورت", "rung": 1000}, {"surah": 25, "startMs": 5480, "verdict": "unknown", "heard": "وقاها لا ابنه ليكون المالمين نبيرا"}, {"surah": 26, "startMs": 7000, "verdict": "unknown", "heard": "بالمنت الكنات كتاب المبين"}, {"surah": 27, "startMs": 6164, "verdict": "unknown", "heard": "تلك ايات الكفان وقتاب من لي"}, {"surah": 28, "startMs": 7148, "verdict": "unknown", "heard": "حم"}, {"surah": 29, "startMs": 5280, "verdict": "clean", "heard": "الم", "rung": 4000}, {"surah": 30, "startMs": 6835, "verdict": "clean", "heard": "الم", "rung": 2000}, {"surah": 31, "startMs": 4520, "verdict": "clean", "heard": "الم", "rung": 3000}, {"surah": 33, "startMs": 280, "verdict": "unknown", "heard": "اذ لا يبعها بطحين"}, {"surah": 34, "startMs": 2989, "verdict": "unknown", "heard": "ليسح الرلا لنينه وابسحا واتوها"}, {"surah": 35, "startMs": 4963, "verdict": "unknown", "heard": "لا اذا قي السماوات واروي جاعل"}, {"surah": 37, "startMs": 3620, "verdict": "unknown", "heard": "فيه والصافصه وهزاك السفاه الهزاه زجرا"}, {"surah": 38, "startMs": 4162, "verdict": "unknown", "heard": "خاد وقران بالذكل بل الذين كفروا"}, {"surah": 39, "startMs": 2980, "verdict": "unknown", "heard": "فسيهم كان الله الازيي الحكيم"}, {"surah": 40, "startMs": 7586, "verdict": "unknown", "heard": "ومن عظاهيم لنا نيسي منني فارجل"}, {"surah": 42, "startMs": 6704, "verdict": "unknown", "heard": "ايمن سيقوا كذلك يوحي"}, {"surah": 43, "startMs": 8536, "verdict": "unknown", "heard": "الا جعلناه قرانا عوضي العلاه تاخلون"}, {"surah": 45, "startMs": 4042, "verdict": "clean", "heard": "حم", "rung": 1000}, {"surah": 47, "startMs": 4040, "verdict": "clean", "heard": "الذين", "rung": 1000}, {"surah": 48, "startMs": 3673, "verdict": "clean", "heard": "انا متنسعون", "rung": 1500}, {"surah": 49, "startMs": 4002, "verdict": "clean", "heard": "يا ايها الذي", "rung": 2000}, {"surah": 50, "startMs": 3933, "verdict": "unknown", "heard": "وافر وقران المجيك بل عجب"}, {"surah": 51, "startMs": 4080, "verdict": "unknown", "heard": "والنانيات ذرا فففي الواه وحري فزانيات"}, {"surah": 52, "startMs": 3548, "verdict": "unknown", "heard": "يولو كتاب هفتم الربي وقب معش"}, {"surah": 53, "startMs": 4033, "verdict": "unknown", "heard": "ونجمي لا هوي ما ولصاحبكم وما"}, {"surah": 54, "startMs": 4368, "verdict": "unknown", "heard": "لهثو عشق وطغ وهي روايك العظو"}, {"surah": 56, "startMs": 10205, "verdict": "unknown", "heard": "وافره الله عهد اذا مجتل عوج"}, {"surah": 57, "startMs": 5040, "verdict": "clean", "heard": "سبح لله", "rung": 1000}, {"surah": 58, "startMs": 6169, "verdict": "unknown", "heard": "يا دل فقيل وجهها وتشتكيه الي"}, {"surah": 59, "startMs": 4635, "verdict": "unknown", "heard": "ما بسماوات وما بمغر ووزير الحكيم"}, {"surah": 60, "startMs": 4756, "verdict": "unknown", "heard": "اذا لنوه لا تتفدوا عدوي وعدوكم"}, {"surah": 61, "startMs": 2909, "verdict": "clean", "heard": "سبح لله", "rung": 1500}, {"surah": 62, "startMs": 4100, "verdict": "unknown", "heard": "ما يا بسماوات وما بما بما"}, {"surah": 63, "startMs": 3680, "verdict": "unknown", "heard": "ينكمنا بكم العقالون شكث يسمك لرسولوه"}, {"surah": 64, "startMs": 3667, "verdict": "unknown", "heard": "فبحجي الله ما بالسماوات وما بمرل"}, {"surah": 65, "startMs": 4082, "verdict": "clean", "heard": "عيها النبي اذا", "rung": 1500}, {"surah": 66, "startMs": 2548, "verdict": "clean", "heard": "يا ايها النبي لم تح